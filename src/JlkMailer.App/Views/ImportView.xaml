<UserControl x:Class="JlkMailer.App.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" VerticalAlignment="Top" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="불러오기" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                       Text="연락처 엑셀과 메일 HTML 템플릿을 선택하세요. 컬럼은 헤더 이름으로 자동 인식되며, 틀리면 직접 고칠 수 있습니다." />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="엑셀 파일" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <TextBox   Grid.Column="1" Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button    Grid.Column="2" Content="찾기…" Command="{Binding BrowseExcelCommand}" Margin="8,0,0,0" />
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="HTML 템플릿" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <TextBox   Grid.Column="1" Text="{Binding HtmlPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button    Grid.Column="2" Content="찾기…" Command="{Binding BrowseHtmlCommand}" Margin="8,0,0,0" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="시트" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="180" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="헤더 행" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="70" Text="{Binding HeaderRow, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="컬럼 매핑" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="엑셀 열 문자(A, B, C…)로 지정합니다." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="병원명" Style="{StaticResource Caption}" />
                    <TextBox Width="58" Text="{Binding HospitalColumn, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="성함" Style="{StaticResource Caption}" />
                    <TextBox Width="58" Text="{Binding NameColumn, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="진료과" Style="{StaticResource Caption}" />
                    <TextBox Width="58" Text="{Binding DeptColumn, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="연락처" Style="{StaticResource Caption}" />
                    <TextBox Width="58" Text="{Binding PhoneColumn, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="이메일" Style="{StaticResource Caption}" />
                    <TextBox Width="58" Text="{Binding EmailColumn, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>

            <Button Content="불러오기" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left" Margin="0,0,0,14" />

            <Border Background="{StaticResource Surface2}" CornerRadius="4" Padding="12,10">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
