<UserControl x:Class="JlkMailer.App.Views.TemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 세그먼트 선택 + 문안 편집 -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="세그먼트" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Text="옆 숫자는 이 문안을 실제로 받는 사람 수입니다." />
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding SegmentItems}" SelectedItem="{Binding SelectedSegment}"
                         FontFamily="{StaticResource MonoFont}" FontSize="12" BorderBrush="{StaticResource Rule}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,14,0,10">
                    <TextBlock Text="발신자명  {{발신자명}}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SenderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="제목" Style="{StaticResource FieldLabel}" />
                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Text="{Binding SubjectLengthText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SubjectTooLong}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Crit}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="{Binding MobilePreview, StringFormat='모바일 표시: {0}'}" />
                </StackPanel>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="인사말" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Greeting, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap"
                                 AcceptsReturn="True" Height="62" Margin="0,0,0,10"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="도입 문단  — 세그먼트 차별화의 대부분이 여기서 나옵니다" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Intro, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap"
                                 AcceptsReturn="True" Height="92" Margin="0,0,0,10"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="장점 리드 문장" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BenefitLead, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap"
                                 AcceptsReturn="True" Height="52" Margin="0,0,0,10"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="맺음말" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Closing, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap"
                                 AcceptsReturn="True" Height="52" Margin="0,0,0,10"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="사용 가능한 토큰" Style="{StaticResource FieldLabel}" />
                        <ItemsControl ItemsSource="{Binding Tokens}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2}" CornerRadius="3" Padding="6,3" Margin="0,0,5,5">
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 오른쪽: 미리보기 -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="미리보기" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding PreviewRecipientText, StringFormat='실제 수신자로 렌더: {0}'}"
                               Style="{StaticResource Caption}" Margin="0,0,0,10" />
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource Surface2}" CornerRadius="4" Padding="12,9" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="제목" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding RenderedSubject}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource Ink}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="4">
                    <TextBox Text="{Binding PreviewPlain, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" />
                </Border>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                               Foreground="{Binding SizeSeverity, Converter={StaticResource SeverityToBrush}}" />
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource Crit}" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="다시 만들기" Command="{Binding RebuildCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="HTML로 저장" Command="{Binding SavePreviewCommand}" Margin="0,0,8,0" />
                    <Button Content="문안 초기화" Command="{Binding ResetSegmentCommand}" />
                    <TextBlock Text="편집됨 — 다시 만들어야 합니다" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="11.5" Foreground="{StaticResource Crit}" FontWeight="SemiBold"
                               Visibility="{Binding Stale, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
