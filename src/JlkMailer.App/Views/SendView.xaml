<UserControl x:Class="JlkMailer.App.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

            <!-- 계정 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="발송 계정" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                               Text="Google Workspace 앱 비밀번호를 사용합니다. 계정에 2단계 인증이 켜져 있어야 발급되며, 조직 정책으로 차단돼 있으면 OAuth 2.0 이 필요합니다." />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="계정 주소" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="앱 비밀번호" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="SecretBox" PasswordChanged="OnSecretChanged" Padding="6,5"
                                         BorderBrush="{StaticResource Rule}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="발신자 이름" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FromName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="회신 주소" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ReplyTo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SMTP 호스트" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="포트" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="연결 테스트" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0" />
                        <CheckBox Content="비밀번호 저장 (Windows DPAPI 암호화)" IsChecked="{Binding RememberSecret}" Margin="0,0,14,0" />
                        <CheckBox Content="인증서 폐기 확인" IsChecked="{Binding CheckCertificateRevocation}" Margin="0,0,14,0"
                                  ToolTip="OCSP 를 차단하는 사내망에서 연결이 끊기면 해제하세요. 체인·호스트명·유효기간 검증은 유지됩니다." />
                        <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{Binding ConnectionSeverity, Converter={StaticResource SeverityToBrush}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 대상 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="대상" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="워밍업 스케줄에 따라 세그먼트를 나눠 보내는 것을 권합니다. 1일차 신경과 50통부터 시작해 반송률을 확인한 뒤 늘리세요." />
                    <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Display}" IsChecked="{Binding Selected}" Margin="0,0,20,4"
                                          FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 속도 · 시간대 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="속도 · 시간대" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="21시~익일 08시는 설정과 무관하게 항상 차단됩니다(정보통신망법). 새벽에 도착한 영업 메일은 그 자체로 자동발송 티가 납니다." />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="간격(초)" Style="{StaticResource FieldLabel}" />
                            <TextBox Width="72" Text="{Binding IntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="지터(±초)" Style="{StaticResource FieldLabel}" />
                            <TextBox Width="72" Text="{Binding JitterSeconds, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="일 상한(통)" Style="{StaticResource FieldLabel}" />
                            <TextBox Width="82" Text="{Binding DailyCap, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <CheckBox Content="오전 09:00–11:00" IsChecked="{Binding MorningWindow}" />
                            <CheckBox Content="오후 14:00–16:00" IsChecked="{Binding AfternoonWindow}" />
                            <CheckBox Content="주말 정지" IsChecked="{Binding SkipWeekends}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{StaticResource Surface2}" CornerRadius="4" Padding="12,9">
                        <TextBlock Text="{Binding EstimateText}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 법규 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="법규 (정보통신망법 제50조)" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="아래 항목은 준수를 가능하게 하는 장치이지 준수를 보장하지 않습니다. 대량 발송 전 사내 법무 확인을 받으세요." />
                    <CheckBox Content="제목 맨 앞에 (광고) 표기" IsChecked="{Binding AdPrefix}" />
                    <CheckBox Content="본문에 수신거부 안내 + List-Unsubscribe 헤더 부착" IsChecked="{Binding IncludeUnsubscribe}" />
                    <StackPanel Margin="24,6,0,0" Width="320" HorizontalAlignment="Left">
                        <TextBlock Text="수신거부 주소" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding UnsubscribeTarget, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 테스트 발송 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="테스트 발송" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="Gmail·Outlook·네이버·모바일 4곳에 실제로 보내 레이아웃을 확인하세요. 국내 병원 수신자는 Outlook 과 네이버 비중이 높습니다. 테스트 발송 없이는 본 발송을 시작할 수 없습니다." />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="280" Text="{Binding TestAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                        <Button Content="테스트 발송" Command="{Binding TestSendCommand}" Margin="0,0,12,0" />
                        <TextBlock Text="✓ 테스트 발송 완료" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="#1B6E52"
                                   Visibility="{Binding TestSendDone, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="▶ 발송 시작" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                        Padding="22,10" FontSize="14" Margin="0,0,14,0" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}"
                           Text="연결 테스트 · 테스트 발송 · 미리보기 생성을 모두 마쳐야 활성화됩니다." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
