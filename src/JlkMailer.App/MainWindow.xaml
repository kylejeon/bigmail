<Window x:Class="JlkMailer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JlkMailer.App.Views"
        Title="JLK-CTP 메일 발송기"
        Height="820" Width="1280" MinHeight="640" MinWidth="1080"
        Background="{StaticResource Ground}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 단계 표시 -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Steps}" Margin="18,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,10,0" Padding="12,6" MinWidth="0" BorderThickness="1"
                                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsEnabled}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Number}" FontWeight="Bold" Margin="0,0,7,0"
                                           Foreground="{StaticResource Amber}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="{Binding Caption}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Surface2}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Navy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 화면 5개. CurrentIndex 로 하나만 보인다. -->
        <Grid Grid.Row="1" Margin="18,14">
            <views:ImportView   DataContext="{Binding Import}"   Visibility="{Binding DataContext.CurrentIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}" />
            <views:ReviewView   DataContext="{Binding Review}"   Visibility="{Binding DataContext.CurrentIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}" />
            <views:TemplateView DataContext="{Binding Template}" Visibility="{Binding DataContext.CurrentIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}" />
            <views:SendView     DataContext="{Binding Send}"     Visibility="{Binding DataContext.CurrentIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}" />
            <views:LogView      DataContext="{Binding Send}"     Visibility="{Binding DataContext.CurrentIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}" />
        </Grid>

        <!-- 하단 내비게이션 -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}"
                           Text="설계 §11 — 좌→우 단방향 진행. 앞 화면의 검증을 통과해야 다음이 열립니다." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀ 이전" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                    <Button Content="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
